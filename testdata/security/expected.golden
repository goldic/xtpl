<!DOCTYPE html><html><head><title>Security examples</title></head><body><h1>Security examples</h1><section id="security"><h2>HTML text and attributes</h2><p class="message">&lt;/script&gt;&lt;img src=x onerror=alert(1)&gt;</p><span title="&#34; onmouseover=&#34;alert(1)">Attribute</span><textarea>&lt;/script&gt;&lt;img src=x onerror=alert(1)&gt;</textarea><h2>URLs</h2><a id="unsafe" href="#ZgotmplZ">Unsafe URL</a><a id="safe" href="https://example.com/path?a=1&amp;b=2">Safe URL</a><a id="search" href="/search?q=a%26next%3djavascript%3aalert%281%29">Search</a><img srcset="#ZgotmplZ, /safe.png 2x"><h2>JavaScript</h2><script>const data = {"text":"\u003c/script\u003e\u003csvg onload=alert(1)\u003e"};
const text = "\u003c\/script\u003e\u003cimg src=x onerror=alert(1)\u003e";</script><h2>CSS</h2><div style="color:ZgotmplZ">Color</div><h2>Explicitly trusted HTML</h2><div><strong>Trusted HTML</strong></div></section></body></html>
